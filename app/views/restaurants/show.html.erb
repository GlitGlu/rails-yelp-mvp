<h1><%= @restaurant.name %></h1>
<p><strong>Category:</strong> <%= @restaurant.category.capitalize %></p>
<p><strong>Address:</strong> <%= @restaurant.address %></p>
<% if @restaurant.phone_number.present? %>
  <p><strong>Phone:</strong> <%= @restaurant.phone_number %></p>
<% end %>

<hr>

<h2>Reviews</h2>
<% if @restaurant.reviews.empty? %>
  <p class="text-muted">No reviews yet. Be the first!</p>
<% else %>
  <% @restaurant.reviews.each do |review| %>
    <div class="card mb-3">
      <div class="card-body">
        <p class="card-text"><%= review.content %></p>
        <p class="text-warning"><strong>Rating: <%= review.rating %>/5</strong></p>
      </div>
    </div>
  <% end %>
<% end %>

<hr>

<h3>Add a Review</h3>
<%= render "reviews/form", restaurant: @restaurant, review: @review %>
